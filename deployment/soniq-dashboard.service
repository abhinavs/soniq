# Soniq Dashboard systemd Service
# Place this file in /etc/systemd/system/soniq-dashboard.service
# Needs: pip install "soniq[dashboard]"

[Unit]
Description=Soniq Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=soniq
Group=soniq
WorkingDirectory=/opt/soniq
EnvironmentFile=-/etc/soniq/soniq.env
Environment=SONIQ_LOG_LEVEL=INFO
# Binds to localhost. Put a reverse proxy in front of it. To listen on
# 0.0.0.0 instead, set SONIQ_DASHBOARD_API_KEY in /etc/soniq/soniq.env.
ExecStart=/opt/soniq/venv/bin/soniq dashboard --host=127.0.0.1 --port=6161
KillMode=mixed
Restart=always
RestartSec=5

# Security settings
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/soniq /var/log/soniq

# Resource limits
MemoryMax=256M
CPUQuota=100%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=soniq-dashboard

[Install]
WantedBy=multi-user.target
