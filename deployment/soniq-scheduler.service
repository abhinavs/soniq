# Soniq Scheduler systemd Service
# Place this file in /etc/systemd/system/soniq-scheduler.service
# Needed only if you use @periodic jobs. Extra copies on other hosts are
# safe: they elect one leader through a PostgreSQL advisory lock.

[Unit]
Description=Soniq Scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=soniq
Group=soniq
WorkingDirectory=/opt/soniq
EnvironmentFile=-/etc/soniq/soniq.env
Environment=SONIQ_LOG_LEVEL=INFO
# The scheduler imports these modules to find the @periodic jobs.
Environment=SONIQ_JOBS_MODULES=myapp.jobs
ExecStart=/opt/soniq/venv/bin/soniq scheduler
KillMode=mixed
TimeoutStopSec=30
Restart=always
RestartSec=5

# Security settings
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/soniq /var/log/soniq

# Resource limits
MemoryMax=256M
CPUQuota=100%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=soniq-scheduler

[Install]
WantedBy=multi-user.target
