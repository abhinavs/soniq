# Soniq Worker systemd Service
# Place this file in /etc/systemd/system/soniq-worker.service
# Run `soniq setup` once per deploy before you start this service.

[Unit]
Description=Soniq Worker
After=network-online.target
Wants=network-online.target
# If PostgreSQL runs on this host, also add:
# After=postgresql.service
# Requires=postgresql.service

[Service]
Type=exec
User=soniq
Group=soniq
WorkingDirectory=/opt/soniq
# Keep secrets out of the unit file. Put SONIQ_DATABASE_URL in this file.
EnvironmentFile=-/etc/soniq/soniq.env
Environment=SONIQ_LOG_LEVEL=INFO
Environment=SONIQ_JOBS_MODULES=myapp.jobs
# soniq-scheduler.service runs @periodic jobs, so silence the worker's
# "no scheduler" warning.
Environment=SONIQ_SCHEDULER_SUPPRESS_WARNING=1
ExecStart=/opt/soniq/venv/bin/soniq worker --concurrency=4
# SIGTERM starts a drain of up to SONIQ_SHUTDOWN_TIMEOUT (30s). Wait longer
# than that before systemd sends SIGKILL. SIGHUP also stops the worker, so
# there is no ExecReload. Use `systemctl restart` to load new code.
KillMode=mixed
TimeoutStopSec=45
Restart=always
RestartSec=5

# Security settings
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/soniq /var/log/soniq

# Resource limits
MemoryMax=512M
CPUQuota=200%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=soniq-worker

[Install]
WantedBy=multi-user.target
